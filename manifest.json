{
  "manifest_version": 3,
  "name": "Focus Friends",
  "version": "1.1",
  "description": "Demuestra que puedes resistir.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["style.css"]
  }],
  "options_page": "options.html",
  "action": { "default_popup": "popup.html" }
}
